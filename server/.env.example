# Required. Long random string; the Android app sends it as "Authorization: Bearer <API_TOKEN>".
# Generate one with: openssl rand -hex 32
API_TOKEN=

PORT=3000
# 127.0.0.1 behind a reverse proxy, or the server's Tailscale IP (e.g. 100.x.y.z) to reach it over Tailscale only.
HOST=127.0.0.1
# SQLite file (messages.db) and WhatsApp auth state (auth/) live here.
DATA_DIR=./data
LOG_LEVEL=info
# Time zone used when showing message times to the summary model.
TZ=Europe/Istanbul

# Optional. Your number in international format without "+" (e.g. 905551234567) to log in with
# an 8-character pairing code instead of scanning the QR. Leave empty to use the QR.
PAIRING_PHONE=

# Summaries
# anthropic | openai. "openai" also covers OpenAI-compatible APIs such as Gemini (see OPENAI_BASE_URL).
SUMMARY_PROVIDER=anthropic
# Defaults to claude-opus-5-5 for anthropic; required for openai.
SUMMARY_MODEL=
SUMMARY_LANGUAGE=Turkish
# Your first name. In groups, only messages that tag you, reply to you, or contain this name count as "for you".
OWNER_NAME=
# Optional. Max model requests started per minute, e.g. 5 for Gemini's free tier. Empty = no limit.
SUMMARY_MAX_RPM=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Gemini: SUMMARY_PROVIDER=openai, OPENAI_API_KEY=<Gemini key>, a Gemini SUMMARY_MODEL, and
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
